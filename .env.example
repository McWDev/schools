# Copy to .env.local for local development. Never commit real values.

# Runtime connection (server-only). Uses the restricted "app_runtime" role, pooled endpoint.
DATABASE_URL="postgresql://app_runtime:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Owner connection for migrations and seeding only. Direct (non-pooled) endpoint.
MIGRATION_DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Owner connection to a disposable test database (Neon "test" branch). Tests wipe its data.
TEST_DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Public base URL of the app (no secrets in NEXT_PUBLIC_ variables).
APP_URL="http://localhost:3217"
