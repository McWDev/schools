# Copy to .env.local for local development. Never commit real values.
# Server-only. Neon pooled connection string for the "development" branch of the "schools" project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Optional: direct (non-pooled) connection used only for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Public base URL of the app (no secrets in NEXT_PUBLIC_ variables).
APP_URL="http://localhost:3217"
